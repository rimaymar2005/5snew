# Copia este archivo a .env (no se versiona) y cambia los valores.
ADMIN_PASSWORD=cambia-esta-contrasena
# Cadena larga y aleatoria, por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-por-una-cadena-aleatoria-larga
PORT=3000
TZ=America/Mexico_City
# Número de proxies HTTPS delante de la app (1 = un proxy)
TRUST_PROXY=1

# Base de datos MariaDB/MySQL (crear con sql/init.sql). Por omisión: contenedor compartido mariadb104.
DB_HOST=mariadb104
DB_PORT=3306
DB_NAME=a5s
# Base de la planta PMC (FC usa DB_NAME). Se crea con sql/init.sql
DB_NAME_PMC=a5s_pmc
DB_USER=a5s
DB_PASSWORD=la-misma-contrasena-que-pusiste-en-init.sql
# Red de contenedores donde vive la base (para llegar a DB_HOST)
DB_NETWORK=php82-mariadb104_php_network

# Correo con Microsoft Graph (opcional; sin estas variables el correo queda desactivado).
# Registro de aplicación en Entra ID con el permiso de aplicación Mail.Send (consentimiento del administrador).
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Buzón desde el que se envía (UPN o buzón compartido)
GRAPH_SENDER=calidad@tuempresa.com
# Quién recibe los avisos del administrador (varios separados por coma); MAIL_ADMIN_FC / MAIL_ADMIN_PMC los separan por planta
MAIL_ADMIN=
# Dirección de la app, para el botón "Abrir la app" de los correos
APP_URL=
# Hora local (0-23) a partir de la cual se mandan los avisos diarios (por omisión 8)
MAIL_HORA=8

# --- Azure (producción) ---
# En Azure NO se usa DB_*: la app detecta `containerArgs` (o AZURE_KEYVAULT_URL) y lee del Key Vault, con la Managed Identity,
# los secretos DBHOST, DBUSER, DBPASSWORD, DBNAME (planta FC), DBNAMEPMC (opcional), DBCHARSET (opcional), ADMINPASSWORD y JWTSECRET.
# Si el vault no se deduce de containerArgs, define su URL aquí (configuración de la app en Azure, no en este archivo):
# AZURE_KEYVAULT_URL=https://<nombre>.vault.azure.net
